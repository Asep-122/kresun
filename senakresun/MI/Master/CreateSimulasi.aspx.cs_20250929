    protected void Data_Formula(object sender, EventArgs e)
    {
        try
        {


            if (ddlinstansi.SelectedValue != "" && ddlkategori.SelectedValue != "" && ddlKantorBayar.SelectedValue != "" && ddlsumberdana.SelectedValue != "" && ddlpensiun.SelectedValue != "" && ddlprogrampinjaman.SelectedValue != "" && txttgllahir.Text != "" && ddljangkawaktu.SelectedValue != "0" && decimal.Parse(txtgajidisplay.Text)>0)
            {

                object tgltmt = CheckTglNull(txtmtpensiun.Text);
