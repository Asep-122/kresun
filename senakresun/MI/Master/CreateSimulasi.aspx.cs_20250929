    public object CheckTglNull(string ParamTanggal)
    {
        object Tanggal;
        if (string.IsNullOrWhiteSpace(ParamTanggal))
        {
            Tanggal = DBNull.Value;
        }
        else
        {
            DateTime parsedDate;
            if (DateTime.TryParse(ParamTanggal, out parsedDate))
            {
                Tanggal = parsedDate;
            }
            else
            {
                Tanggal = DBNull.Value;
            }
        }

        return Tanggal;
    }


