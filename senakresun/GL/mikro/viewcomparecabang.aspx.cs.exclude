                    string query = "";
                    String constr = ConfigurationManager.ConnectionStrings["postgreskresun"].ConnectionString;
                    query = "   SELECT min(c.tahun) as tahun,min(c.bulan) as bulan,c.perkiraan_bahan, sum(c.saldo_akhir) as saldoakhir, min(k.nama_koperasi) as nama_koperasi,min(a.nama_area) as nama_area,";
                    query = query + " min(b.nama_bahan) as nama_bahan,min(b.groupx) as groupx,min(b.type_rek) as type_rek,min(b.kategori) as kategori,min(b.type_font) as type_font,";
                    query = query + " (array_to_string(array_agg(m.cabang_nama), ', ')) as cabang_nama,";
                    query = query + " min(case when b.groupx = 'A' then 'AKTIVA' else case when b.groupx = 'B' then 'PASIVA' else case when b.groupx = 'C' then 'PROFIT  &  LOSS  CUMULATIVE' else 'DATA - DATA PENUNJANG' end end end) as nama_group , ";
                    query = query + " sum(case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '1' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '1' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end) as saldobulanlalu1, ";
                    query = query + " sum(case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '2' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '2' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end) as saldobulanlalu2, ";
                    query = query + " sum(case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '3' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '3' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end) as saldobulanlalu3, ";
                    query = query + " sum(case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '4' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '4' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end) as saldobulanlalu4,";
                    query = query + " sum(case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '5' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '5' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end) as saldobulanlalu5, ";
                    query = query + " sum(case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '6' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '6' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end) as saldobulanlalu6,";
                    query = query + " sum(case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '7' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '7' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end) as saldobulanlalu7,";
                    query = query + " sum(case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '8' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '8' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end) as saldobulanlalu8,";
                    query = query + " sum(case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '9' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '9' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end) as saldobulanlalu9,";
                    query = query + " sum(case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '10' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '10' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end) as saldobulanlalu10,";
                    query = query + " sum(case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '11' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '11' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end) as saldobulanlalu11,";
                    query = query + " sum(case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '12' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = '12' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end) as saldobulanlalu12, ";
                    query = query + " sum(case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = cast(c.tahun::int - 1 as VARCHAR) and x.bulan = '12' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = cast(c.tahun::int - 1 as VARCHAR) and x.bulan = '12' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end) as saldobulanlalu13,  ";
                    query = query + " sum(case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = cast(c.tahun::int - 1 as VARCHAR) and x.bulan = '11' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = cast(c.tahun::int - 1 as VARCHAR) and x.bulan = '11' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end) as saldobulanlalu14,";
                    query = query + " sum(case when c.bulan = '1' then  case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = cast(c.tahun::int - 1 as VARCHAR) and x.bulan = '12' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = cast(c.tahun::int - 1 as VARCHAR) and x.bulan = '12' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end else   case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = cast(c.bulan::int - 1 as VARCHAR) and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = cast(c.bulan::int - 1 as VARCHAR) and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end end ) as saldobulanlalu,";
                    query = query + " min(TO_CHAR(TO_DATE(c.bulan::text, 'MM'), 'Month')) AS namebulan, sum(c.saldo_akhir) -sum(case when c.bulan = '1' then  case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = cast(c.tahun::int - 1 as VARCHAR) and x.bulan = '12' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = cast(c.tahun::int - 1 as VARCHAR) and x.bulan = '12' and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end else  case when(select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = cast(c.bulan::int - 1 as VARCHAR) and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) is null then 0 else (select sum(saldo_akhir) from tbl_master_perkiraan_bahan_calculate x where x.tahun = c.tahun and x.bulan = cast(c.bulan::int - 1 as VARCHAR) and x.perkiraan_bahan = c.perkiraan_bahan and x.kode_cabang = c.kode_cabang) end end) as delta ";
                    query = query + " FROM tbl_master_perkiraan_bahan_calculate c ";
                    query = query + " inner join tbl_master_perkiraan_mapping m on m.kode_cabang = c.kode_cabang ";
                    query = query + " inner join tbl_master_perkiraan_koperasi k on k.kode_koperasi = m.kode_koperasi ";
                    query = query + " inner join tbl_master_perkiraan_area a on a.kode_area = m.kode_area ";
                    query = query + " inner join tbl_master_perkiraan_bahan b on b.perkiraan_bahan = c.perkiraan_bahan ";
                    query = query + " where c.tahun = '" + ddlTahun.SelectedValue + "' and c.bulan = '" + ddlbulan.SelectedValue + "'";
                    query = query + " and  a.kode_area='" + ddlarea2.SelectedValue + "'";
                    query = query + " and  m.kode_nik='" + ddlrm2.SelectedValue + "'";
                    query = query + "  group by c.perkiraan_bahan ";
                    query = query + "  order by c.perkiraan_bahan asc ";
                    using (NpgsqlConnection conx = new NpgsqlConnection(constr))
                    {
                        using (NpgsqlCommand cmdx = new NpgsqlCommand(query))
                        {
                            using (NpgsqlDataAdapter sdax = new NpgsqlDataAdapter())
                            {
                                cmdx.Connection = conx;
                                sdax.SelectCommand = cmdx;

                                using (DataSet ds2 = new DataSet())
                                {
                                    sdax.Fill(ds2);

                                    string xnama;
                                    string groupx;
                                    string noperkiraan;
                                    string ku_mingguan;
                                    foreach (DataTable dt2 in ds2.Tables)
                                    {
                                        //Add DataTable as Worksheet.


                                        worksheet.Cell("E1").Value = "Compare 2 " + ddlarea2.SelectedItem.Text;
                                        worksheet.Range("E1:G1").Row(1).Merge();
                                        worksheet.Cell("E1").Style.Font.FontName = "ARIAL";
                                        worksheet.Cell("E1").Style.Font.FontSize = 12;
                                        worksheet.Cell("E1").Style.Font.Bold = true;
                                        worksheet.Cell("E1").Style.Alignment.SetHorizontal(XLAlignmentHorizontalValues.Center);

                                        worksheet.Cell("E2").Value = ddlrm2.SelectedItem.Text;
