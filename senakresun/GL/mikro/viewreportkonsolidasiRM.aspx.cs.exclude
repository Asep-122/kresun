        if (ddltypereport.SelectedValue == "1")

        {
            ddlrmcrm.Enabled = false;            
            DdlReport.Enabled = false;
            DdlReport.SelectedValue = "6";
            
        }
        else if(ddltypereport.SelectedValue == "2")
        {
            ddlrmcrm.Enabled = true;
            DdlReport.Enabled = true;

        }
      



    }

