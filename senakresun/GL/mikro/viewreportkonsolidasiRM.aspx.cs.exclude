    protected void Page_Load(object sender, EventArgs e)
    {
        try
        {
            if (!IsPostBack)
            {
                DefaultClass.Global.SqlHelper[] var1 = new DefaultClass.Global.SqlHelper[3];
                var1[0] = gb.CreateSPParameter("@STATE", ParameterDirection.Input, SqlDbType.VarChar, 50, "AREA", typeof(string));
                var1[1] = gb.CreateSPParameter("@ErrMsg", ParameterDirection.Output, SqlDbType.VarChar, 8000, ParameterDirection.Output, typeof(string));
                var1[2] = gb.CreateSPParameter("@Kodecabang", ParameterDirection.Input, SqlDbType.VarChar, 10, SessBranchID, typeof(string));
                ge.ListDataset = gb.GetDataJustOutPut("GL_BAHAN_CABANG", var1, "constrmf");
                ge.ListDataset.Tables[0].DefaultView.Sort = "kode_area asc";
                ddlarea.DataSource = ge.ListDataset.Tables[0].DefaultView.ToTable();
                ddlarea.DataTextField = "nama_area";
                ddlarea.DataValueField = "kode_area";
                ddlarea.DataBind();
      
                ddlarea.Enabled = true;


                DefaultClass.Global.SqlHelper[] var2 = new DefaultClass.Global.SqlHelper[3];
                var2[0] = gb.CreateSPParameter("@STATE", ParameterDirection.Input, SqlDbType.VarChar, 50, "RMCRMMAPPING", typeof(string));
                var2[1] = gb.CreateSPParameter("@ErrMsg", ParameterDirection.Output, SqlDbType.VarChar, 8000, ParameterDirection.Output, typeof(string));
                var2[2] = gb.CreateSPParameter("@kodearea", ParameterDirection.Input, SqlDbType.VarChar, 10, ddlarea.SelectedValue, typeof(string));
                ge.ListDataset = gb.GetDataJustOutPut("GL_BAHAN_CABANG", var2, "constrmf");
                ge.ListDataset.Tables[0].DefaultView.Sort = "nama_karyawan asc";
                ddlrmcrm.DataSource = ge.ListDataset.Tables[0].DefaultView.ToTable();
                ddlrmcrm.DataTextField = "nama_karyawan";
                ddlrmcrm.DataValueField = "id_mapping";
                ddlrmcrm.DataBind();
             


                ddlrmcrm.Enabled = false;
                //ddlrmcrm.Items.Insert(0, new ListItem("Pilih RM/CRM", "ALL"));
                ddlrmcrm.Enabled = false;
                ddltypereport.SelectedValue = "1";
                DdlReport.Enabled = false;
                DdlReport.SelectedValue = "6";
                ambilTahun();
                ambilBulan();


                
            }
        }
        catch (System.Exception X)
        {
            ScriptManager.RegisterStartupScript(this, this.GetType(), "Javascript", "javascript:SweetAlert('" + X.Message.ToString() + "');", true);

            //gb.SaveErroLog(X.Message.ToString(), Path.GetFileName(Request.Path), SessLoginID, Server.MapPath("~/ErrorLog/" + "ErrorLog" + DateTime.Now.ToString("MM") + DateTime.Now.ToString("yyyy") + ".xml"));

        }
    }

    //'int total = 0;
    decimal plafon = 0, nasabah = 0, baki = 0;
    decimal Total = 0, jmlbaru = 0, plafonbaru = 0, jmllama = 0, plafonlama=0,jmltotal=0, plafontotal=0;
    protected void Grdtagihank_RowDataBound(object sender, GridViewRowEventArgs e)
    {

        if (e.Row.RowType == DataControlRowType.DataRow)
        {

            Total += 1;
            jmlbaru += Convert.ToDecimal(DataBinder.Eval(e.Row.DataItem, "total"));
            jmltotal += Convert.ToDecimal(DataBinder.Eval(e.Row.DataItem, "terima"));

        }
        if (e.Row.RowType == DataControlRowType.Footer)
        {
            Label lbltotal = (Label)e.Row.FindControl("lblTotal");
            lbltotal.Text = Total.ToString();
            Label lbljmlbaru = (Label)e.Row.FindControl("lbljmlbaru");
            lbljmlbaru.Text = jmlbaru.ToString("#,##0.00");

            Label lblterimabaru = (Label)e.Row.FindControl("lblterimabaru");
            lblterimabaru.Text = jmltotal.ToString("#,##0.00");


        }
    }
    public void ambilTahun()
    {
        var currentYear = DateTime.Today.Year;
        for (int i = 3; i >= 0; i--)
        {
            // Now just add an entry that's the current year minus the counter
            ddlTahun.Items.Add((currentYear - i).ToString());
        }
        ddlTahun.SelectedValue = currentYear.ToString();
        if (SessBranchID != "000")
        {
            ddlTahun.Enabled = false;
        }
        else
        {
            ddlTahun.Enabled = true;
        }
    }

    public void ambilBulan()
    {
        var months = CultureInfo.CurrentCulture.DateTimeFormat.MonthNames;
        for (int i = 0; i < months.Length; i++)
        {
            ddlbulan.Items.Add(new ListItem { Text = months[i].ToString(), Value = (i + 1).ToString() });
        }
        var currentmonth = DateTime.Today.Month - 1;
        ddlbulan.SelectedValue = currentmonth.ToString();
        if (SessBranchID != "000")
        {
            ddlbulan.Enabled = false;
        }
        else
        {
            ddlbulan.Enabled = true;
        }
    }


    protected void ddltypereport_SelectedIndexChanged(object sender, EventArgs e)
