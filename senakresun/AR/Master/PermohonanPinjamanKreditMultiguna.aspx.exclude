                </span></span> 
    
            </asp:Panel> 

            <asp:Panel ID="pnlKeanggotaan" Visible="false" runat="server">
              <div class="clearfix">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12"> 
                                                   <div class="card-box ribbon-box">
                                                    <div class="ribbon ribbon-custom">DATA KEANGGOTAAN NASABAH</div>
                                                       <p class="m-b-0"></p>
                                                    <div class="form-row">
                                                          
                                                        <div class="form-group col-md-6">
                                                           
                                                             <div class="form-group">
                                                                <asp:label ID="Label85" runat="server" class="col-form-label">Simpanan Pokok</asp:label>
																<asp:TextBox ID="txtsimpok" CssClass="form-control" required="required" Enabled="false" runat="server" ></asp:TextBox> 
															 </div>
															
															 
                                                        </div>
                                                        <div class="form-group col-md-6">
                                                            
                                                            <div class="form-group">
                                                                <asp:label ID="Label89" runat="server" class="col-form-label">Simpanan Wajib</asp:label>
																<asp:TextBox ID="txtsimwa" CssClass="form-control" required="required" Enabled="false" runat="server" ></asp:TextBox> 
                                                             </div>

                                                           

                                                        </div>


													</div>
												</div>  

                                            </div>
                                         </div>        
                  
                                       <div class="hidden-print mt-4">
                                                <div class="float-left mb-2"> 
                                                   
                                                    
                                                        <asp:Button ID="btnBackPengajuan" align="right" class="btn btn-success waves-light text-white" runat="server" Text="BACK" OnClick="btnBackPengajuan_Click" />
                                                        

                                                    </div>
                                                <div class="float-right mb-2 "> 
                                                   
                                                     <asp:Button ID="btnNextPengajuan" align="right" CssClass="btn btn-success waves-light text-white" runat="server" Text="NEXT" OnClick="btnNextPengajuan_Click" Width="65px" />

                                                    </div>
                                            </div> 
    
                </span></span> 
    
            </asp:Panel> 

            <asp:Panel ID="pnlJaminan" Visible="false" runat="server">
              <div class="clearfix">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12"> 
                                                   <div class="card-box ribbon-box"> 
                                                    <div class="ribbon ribbon-custom">UPLOAD BUKTI JAMINAN</div>
                                                       <p class="m-b-0"></p>
                                                    <div class="form-row">
                                                          
                                                        <div class="form-group col-md-6">
                                                           
                                                           
                                                            <div>
                                                                <asp:FileUpload ID="fileuploadjaminan" runat="server"/> 
                                                                <asp:Button ID="btnjaminan" Text="Upload" runat="server" OnClick="UploadFileJaminan" OnClientClick="return CheckFileExistenceJaminan()" />
                                                                <hr />
                                                                    <asp:TextBox ID="txtpathjaminan" CssClass="form-control" enabled = "false"   runat="server" MaxLength="400"></asp:TextBox>
                                                                   
                                                                <hr /> 

                                                                  <div class="form-group">
                                                                <asp:label ID="Label54" runat="server" class="col-form-label">Keterangan Jaminan</asp:label>
																<asp:TextBox ID="txtketeranganJaminan"  CssClass="form-control"  TextMode="MultiLine" Rows="6" runat="server" data-style="btn-custom" ></asp:TextBox>      
                                                            
                                                            </div> 
                                                            </div>

                                                          
															
															 
                                                         
                                                        </div>

                                                        <div class="form-group col-md-6">
                                                           
                                                           
                                                            <div>
                                                                  <asp:Image ID="imgjaminan" runat="server" Height="300px" Width="550px" />
                                                            </div>

                                                          
															
															 
                                                         
                                                        </div> 

													</div>
												</div>  

                                            </div>
                                         </div>         
                </span></span> 
    
            </asp:Panel> 
            <asp:Panel ID="pnlUsaha" Visible="false" runat="server">
              <div class="clearfix">
                                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12"> 
                                                   <div class="card-box ribbon-box">
                                                    <div class="ribbon ribbon-custom">DATA KRITERIA USAHA NASABAH</div>
                                                       <p class="m-b-0"></p>
                                                    <div class="form-row">
                                                         
                                                       <asp:HiddenField ID="HiddenField1" runat="server"/> 
                                                        <div class="form-group col-md-6">
                                                           
                                                             <div class="form-group">
                                                                <asp:label ID="Label82" runat="server" class="col-form-label">Kondisi Usaha Saat Ini</asp:label>
																<asp:TextBox ID="txtkondisiusaha" CssClass="form-control" runat="server" maxlength ="200"></asp:TextBox> 
															 </div>
															
															<div class="form-group">
                                                                <asp:label ID="Label83" runat="server" class="col-form-label">Karakter Anggota</asp:label>
																<asp:TextBox ID="txtKarakterAnggota" CssClass="form-control" runat="server" maxlength ="200"></asp:TextBox> 
                                                            </div>

                                                            <div class="form-group">
                                                                <asp:label ID="Label84" runat="server" class="col-form-label">Info Anggota dari Pihak ke 3</asp:label>
																<asp:TextBox ID="txtinfo" CssClass="form-control" runat="server" maxlength ="200" ></asp:TextBox> 
                                                            </div>
                                                              
                                                         
                                                        </div>
                                                        <div class="form-group col-md-6">
                                                            
                                                            <div class="form-group">
                                                                <asp:label ID="Label103" runat="server" class="col-form-label">Kondisi Pesaing</asp:label>
																<asp:TextBox ID="txtkondisipesaing" CssClass="form-control"  runat="server" maxlength ="200"></asp:TextBox> 
                                                             </div>

                                                             <div class="form-group">
                                                                 <asp:label id="Label104" runat="server"  class="col-form-label">Resiko Usaha</asp:label>
                                                                 <asp:TextBox ID="txtresikousaha" CssClass="form-control"  runat="server" maxlength ="200"></asp:TextBox> 
                                                             </div>   

                                                              <div class="form-group">
                                                                <asp:label ID="Label105" runat="server" class="col-form-label">Upaya Mengatasi Resiko Usaha</asp:label>
																<asp:TextBox ID="txtatasiresiko" CssClass="form-control"    runat="server" maxlength ="250"></asp:TextBox>
                                                                 
                                                              </div>


                                                        </div>


													</div>
												</div>  

                                            </div>
                                         </div>        
                  
                                            <div class="hidden-print mt-4">
                                                <div class="float-left mb-2"> 
                                                   
                                                    
                                                        <asp:Button ID="btnBackUsaha" align="right" class="btn btn-success waves-light text-white" runat="server" Text="BACK" OnClick="btnBackUsaha_Click" />
                                                        

                                                    </div>
                                                <div class="float-right mb-2 "> 
                                                   
                                                     <asp:Button ID="btnSimpan" align="right" CssClass="btn btn-success waves-light text-white" runat="server" Text="Save" OnClick="btnSimpan_Click" Width="65px" OnClientClick="return sweetAlertsave(this,'Apakah anda yakin ingin Menyetujui data ini ?');"/> 

                                                    </div>
                                            </div> 
    
                </span></span> 
    
            </asp:Panel> 
                 
           
                 

            </div> 
        <!-- end wrapper -->
        </ContentTemplate>
             <Triggers>  
                <asp:PostBackTrigger ControlID="btnSearch" />
                <asp:PostBackTrigger ControlID="btnBackUsaha" />
                <asp:PostBackTrigger ControlID="btnBackPekerjaan" />
                <asp:PostBackTrigger ControlID="btnBackTambahan" />
                <asp:PostBackTrigger ControlID="btnBackPendapatan" /> 
                 
                <asp:PostBackTrigger ControlID="btnCancel" />
                <asp:PostBackTrigger ControlID="btnNext" />
                <asp:PostBackTrigger ControlID="btnSimpan" />
                <asp:PostBackTrigger ControlID="btnNextLaba" />
                <asp:PostBackTrigger ControlID="btnNextPekerjaan" />
                <asp:PostBackTrigger ControlID="btnNextPendapatan" /> 
                <asp:PostBackTrigger ControlID="btnjaminan" /> 
                <asp:AsyncPostBackTrigger ControlID="ddlprogrampinjaman" />
                <asp:AsyncPostBackTrigger ControlID="ddlprogrampinjaman" />
            </Triggers>
        </asp:UpdatePanel>
    </form>
</body>
  
    
