                                                                    <div class="form-group col-md-6">
                                                                         <asp:TextBox ID="txtkalicadangan" MaxLength="2" CssClass="form-control"  runat="server" onkeypress="return isnumerickey(event);" AutoPostBack="true"  OnTextChanged="txtkalicadangan_TextChanged" ></asp:TextBox>
                                                                    </div>
                                                                    <div class="form-group col-md-5">
                                                                        <asp:TextBox ID="TextBox3" CssClass="form-control" Enabled="false" onkeypress="return isnumerickey(event);" MaxLength="18"  required="required" runat="server"  onkeyup="javascript:this.value=Comma(this.value);"  onblur="checkTextField1(this);"></asp:TextBox>
                                                                 
                                                                    </div>
                                                                </div>

																
                                                            </div> 

                                                             <div class="form-group">
                                                                <asp:label ID="Label71" runat="server" class="col-form-label">Nilai Taksasi</asp:label>
																<asp:TextBox ID="TextBox5" CssClass="form-control"  MaxLength="18"  required="required" runat="server"  onkeyup="javascript:this.value=Comma(this.value);" onkeypress="return isnumerickey(event);" onblur="checkTextField1(this);"   >0</asp:TextBox>
                                                                 
                                                            </div> 

                                                            <div class="form-group">
                                                                <asp:label ID="Label72" runat="server" class="col-form-label">Jatuh Tempo</asp:label>
																<asp:TextBox ID="txtjttempo" CssClass="form-control"  Enabled="false"   required="required" runat="server" ></asp:TextBox>
                                                                 
                                                            </div> 

                                                            <div class="form-group">
                                                                <asp:label ID="Label73" runat="server" class="col-form-label">Angsuran Dimuka</asp:label>
																<asp:TextBox ID="txtangsurandimuka" CssClass="form-control"   onkeypress="return isnumerickey(event);" MaxLength="18"  required="required" runat="server"  onkeyup="javascript:this.value=Comma(this.value);"  onblur="checkTextField1(this);">0</asp:TextBox>
                                                                 
                                                            </div>  

                                                            <div class="form-group">
                                                                <asp:label ID="Label74" runat="server" class="col-form-label">Biaya Materai</asp:label>
																<asp:TextBox ID="txtbymaterai" CssClass="form-control"    onkeypress="return isnumerickey(event);" MaxLength="18"  required="required" runat="server"  onkeyup="javascript:this.value=Comma(this.value);"  onblur="checkTextField1(this);">0</asp:TextBox>
                                                                 
                                                            </div>

                                                             <div class="form-group">
                                                                <asp:label ID="Label75" runat="server" class="col-form-label">Biaya Asuransi</asp:label>
																<asp:TextBox ID="txtbyasuransi" CssClass="form-control"    onkeypress="return isnumerickey(event);" MaxLength="18"  required="required" runat="server"  onkeyup="javascript:this.value=Comma(this.value);"  onblur="checkTextField1(this);">0</asp:TextBox>
                                                                 
                                                            </div> 

                                                            <div class="form-group">
                                                                <asp:label ID="Label76" runat="server" class="col-form-label">Biaya Pelunasan</asp:label>
																<asp:TextBox ID="txtbypelunasan" CssClass="form-control"    onkeypress="return isnumerickey(event);" MaxLength="18"  required="required" runat="server"  onkeyup="javascript:this.value=Comma(this.value);"  onblur="checkTextField1(this);">0</asp:TextBox>
                                                                 
                                                            </div> 

                                                              <div class="form-group">
                                                                <asp:label ID="Label77" runat="server" class="col-form-label">Biaya Notaris</asp:label>
																<asp:TextBox ID="txtbynotaris" CssClass="form-control"    onkeypress="return isnumerickey(event);" MaxLength="18"  required="required" runat="server"  onkeyup="javascript:this.value=Comma(this.value);"  onblur="checkTextField1(this);">0</asp:TextBox>
                                                                 
                                                            </div> 
                                                             <div class="form-group">
                                                                <asp:label ID="Label78" runat="server" class="col-form-label">Blokir Angs</asp:label>
																<asp:TextBox ID="TextBox14" CssClass="form-control"   onkeypress="return isnumerickey(event);" MaxLength="18"  required="required" runat="server"  onkeyup="javascript:this.value=Comma(this.value);"  onblur="checkTextField1(this);">0</asp:TextBox>
                                                                 
                                                            </div> 
                                                            <div class="form-group">
                                                                <asp:label ID="Label79" runat="server" class="col-form-label">Nominal Blokir Angs</asp:label>
																<asp:TextBox ID="TextBox15" CssClass="form-control"    onkeypress="return isnumerickey(event);" MaxLength="18"  required="required" runat="server"  onkeyup="javascript:this.value=Comma(this.value);"  onblur="checkTextField1(this);">0</asp:TextBox>
                                                                 
                                                            </div> 

