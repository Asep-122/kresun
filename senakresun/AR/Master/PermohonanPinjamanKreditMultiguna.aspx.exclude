																<asp:TextBox ID="TextBox13" CssClass="form-control" maxlength ="80"  required="required" runat="server" ></asp:TextBox>
                                                                <asp:RequiredFieldValidator id="RequiredFieldValidator2" runat="server" SetFocusOnError="True" ControlToValidate="TextBox13"  ErrorMessage="Nama Penjamin tidak boleh kosong"  ForeColor="Red"></asp:RequiredFieldValidator>
                                                           
                                                                 
                                                              </div>

                                                              <div class="form-group">
