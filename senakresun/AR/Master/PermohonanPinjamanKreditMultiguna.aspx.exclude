                                                                <asp:label ID="Label80" runat="server" class="col-form-label">Jenis Blokir</asp:label>
																<asp:DropDownList ID="ddljenisblokir" CssClass="selectpicker show-tick" runat="server" data-style="btn-custom" ></asp:DropDownList>
