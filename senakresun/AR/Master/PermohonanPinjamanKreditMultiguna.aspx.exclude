                                                             </div>

                                                            <div class="form-group">
                                                                <asp:label ID="Label52" runat="server" class="col-form-label">Pendapatan/Bulan</asp:label>
																<asp:TextBox ID="txtpendapatanperbulan" CssClass="form-control" MaxLength="18"  required="required" runat="server"  onkeyup="javascript:this.value=Comma(this.value);" onkeypress="return isnumerickey(event);" onblur="checkTextField1(this);"   ></asp:TextBox>
                                                                 
                                                            </div> 
                                                            
                                                            <div class="form-group">
                                                                <asp:label ID="Label53" runat="server" class="col-form-label">Fisik Jaminan</asp:label>
																<asp:DropDownList ID="ddlfisikjaminan" CssClass="selectpicker show-tick" runat="server" data-style="btn-custom" ></asp:DropDownList>
                                                             </div>
                                                            
                                                          

                                                            <div class="form-group">
                                                                <asp:label ID="Label69" runat="server" class="col-form-label">Jaminan Tambahan</asp:label>
																<asp:TextBox ID="TextBox1" CssClass="form-control" maxlength ="100"   required="required" runat="server" ></asp:TextBox>
                                                                 
                                                            </div> 
                                                            <div class="form-group">
                                                                <label runat="server" class="col-form-label">Jenis Biaya Cadangan</label>
                                                                <asp:DropDownList ID="ddlbycad" Required="False" CssClass="selectpicker show-tick" runat="server" data-style="btn-custom" AutoPostBack="true" OnSelectedIndexChanged ="ddlbycad_SelectedIndexChanged"></asp:DropDownList>
                                                            </div> 

                                                            <div class="form-group">
                                                                <asp:label ID="Label70" runat="server" class="col-form-label" Visible="false">Biaya Cadangan</asp:label>
