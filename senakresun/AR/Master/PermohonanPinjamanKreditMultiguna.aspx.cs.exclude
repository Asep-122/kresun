    protected void txtjangka_TextChanged(object sender, EventArgs e)
    {
        double nominal_provisi = 0;
        int i = 0;
        DefaultClass.Global.SqlHelper[] var1 = new DefaultClass.Global.SqlHelper[3];
        var1[0] = gb.CreateSPParameter("@no_nasabah", ParameterDirection.Input, SqlDbType.VarChar, 50, txtnonasabah.Text, typeof(string));
        var1[1] = gb.CreateSPParameter("@STATE", ParameterDirection.Input, SqlDbType.VarChar, 50, "SELECT", typeof(string));
        var1[2] = gb.CreateSPParameter("@ErrMsg", ParameterDirection.Output, SqlDbType.VarChar, 8000, ParameterDirection.Output, typeof(string));

        ge.ListDataset = gb.GetDataJustOutPut("GetMasterKredit", var1, "constrmf");

        ddlprogrampinjaman.DataSource = ge.ListDataset.Tables[0].DefaultView.ToTable();

        if (ge.ListDataset.Tables[0].DefaultView.Count == 0)
        {
            HDStatusDebitur.Value = "B";
        }
        else
        {
            HDStatusDebitur.Value = "-";
        }

        string kode_wilayah = "";

        if (SessKdpersh == "01")
        {
            kode_wilayah = "I";
        }
        else if (SessKdpersh == "02")
        {
            kode_wilayah = "II";
        }
        else if (SessKdpersh == "03")
        {
            kode_wilayah = "III";
        }
        else if (SessKdpersh == "04")
        {
            kode_wilayah = "IV";
        }
        else if (SessKdpersh == "05")
        {
            kode_wilayah = "V";
        }

        DefaultClass.Global.SqlHelper[] var2 = new DefaultClass.Global.SqlHelper[8];
        var2[0] = gb.CreateSPParameter("@KodeBank", ParameterDirection.Input, SqlDbType.VarChar, 50, ddlsumberdana.SelectedValue, typeof(string));
        var2[1] = gb.CreateSPParameter("@KodeProduk", ParameterDirection.Input, SqlDbType.VarChar, 50, ddlprodukpengajuan.SelectedValue, typeof(string));
        var2[2] = gb.CreateSPParameter("@Jangka", ParameterDirection.Input, SqlDbType.VarChar, 50, txtjangka.Text, typeof(string));
        var2[3] = gb.CreateSPParameter("@Wilayah", ParameterDirection.Input, SqlDbType.VarChar, 50, kode_wilayah, typeof(string));
        var2[4] = gb.CreateSPParameter("@StatusSK", ParameterDirection.Input, SqlDbType.VarChar, 50, ddlprogrampinjaman.SelectedValue, typeof(string));
        var2[5] = gb.CreateSPParameter("@statusDebitur", ParameterDirection.Input, SqlDbType.VarChar, 50, HDStatusDebitur.Value, typeof(string));
        var2[6] = gb.CreateSPParameter("@STATE", ParameterDirection.Input, SqlDbType.VarChar, 50, "SELECTSUKUBUNGA", typeof(string));
        var2[7] = gb.CreateSPParameter("@ErrMsg", ParameterDirection.Output, SqlDbType.VarChar, 8000, ParameterDirection.Output, typeof(string));

        ge.ListDataset = gb.GetDataJustOutPut("GetSukuBungaProduk", var2, "constrmf");

        if (ge.ListDataset.Tables[0].DefaultView.Count == 0)
        {
            ScriptManager.RegisterStartupScript(this, this.GetType(), "Javascript", "javascript:SweetAlert('Tidak ada sumber dana memenuhi kriteria pinjaman!');", true);
            txtjangka.Text = "";
            txtjangka.Focus();
        }
        else
        {
            txtbunga.Text = ge.ListDataset.Tables[0].Rows[0]["bunga"].ToString();
            txtProvisi.Text = ge.ListDataset.Tables[0].Rows[0]["Provisi"].ToString();


            nominal_provisi = double.Parse(txtplafon.Text.Replace(".", "").Replace(",00","")) * (double.Parse(txtProvisi.Text.ToString().Replace(".", ",").Trim())) / 100;
            txtnominalprovisi.Text = nominal_provisi.ToString();

            pokok = gb.GetPokok(int.Parse(txtjangka.Text), double.Parse(txtplafon.Text.Replace(".", "").Replace(",00", "")));
            bunga = gb.GetNominalBunga(Double.Parse(txtbunga.Text.Trim().Replace(".", ",")), int.Parse(txtjangka.Text), double.Parse(txtplafon.Text.Replace(".", "").Replace(",00", "")), ddlprodukpengajuan.SelectedValue);

            //txtangsuranperbulan.Text = gb.GetAdmProvisi(Double.Parse(txtbunga.Text.Trim().Replace(".", ",")), int.Parse(txtjangka.Text), double.Parse(txtplafon.Text));
            angsuranperbulan = double.Parse(pokok) + double.Parse(bunga);
            txtangsuranperbulan.Text = angsuranperbulan.ToString();

            //HITUNG JATUH TEMPO BERDASARKAN JANGKA DAN HARI LIBUR

            if (ddlprodukpengajuan.SelectedValue == "3C")
            {
                for (i = 0; i < int.Parse(txtjangka.Text); i++)
                {
                    if (i == 0)
                    {
                        tgl_realisasi = DateTime.Parse(txttglrealisasi.Text);
                        tgl_libur = tgl_realisasi.AddDays(7);
                    }
                    else
                    {
                        tgl_libur = tgldrop.AddDays(7);
                    }

                    DefaultClass.Global.SqlHelper[] var3 = new DefaultClass.Global.SqlHelper[3];
                    var3[0] = gb.CreateSPParameter("@tglLibur", ParameterDirection.Input, SqlDbType.SmallDateTime, 50, tgl_libur, typeof(string));
                    var3[1] = gb.CreateSPParameter("@STATE", ParameterDirection.Input, SqlDbType.VarChar, 50, "SELECT", typeof(string));
                    var3[2] = gb.CreateSPParameter("@ErrMsg", ParameterDirection.Output, SqlDbType.VarChar, 8000, ParameterDirection.Output, typeof(string));

                    ge.ListDataset = gb.GetDataJustOutPut("GetTglLibur", var3, "constrmf");

                    if (ge.ListDataset.Tables[0].DefaultView.Count == 0)
                    {
                        tgldrop = tgl_libur;
                    }
                    else
                    {
                        tgldrop = tgl_libur.AddDays(7);
                    }

                }

                txtjttempo.Text = tgldrop.ToString("dd-MMM-yyyy");


            }
            else if (ddlprodukpengajuan.SelectedValue == "3B")
            {
                tgl_realisasi = DateTime.Parse(txttglrealisasi.Text);
                tgl_libur = tgl_realisasi.AddMonths(int.Parse(txtjangka.Text));

                txtjttempo.Text = tgl_libur.ToString("dd-MMM-yyyy");
            }
        }


    }

