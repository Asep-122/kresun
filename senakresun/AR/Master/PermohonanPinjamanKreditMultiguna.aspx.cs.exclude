    protected void txtbiayalain_TextChanged(object sender, EventArgs e)
    {
        double labakotor = 0, totalbiaya = 0, lababersih = 0;
        labakotor = Convert.ToDouble(txtpendapatanusaha.Text) - Convert.ToDouble(txthargapokok.Text);
        totalbiaya = Convert.ToDouble(txtbiayapegawai.Text) + Convert.ToDouble(txtbiayalain.Text);
        lababersih = labakotor - totalbiaya;

        txtlabakotor.Text = gb.ToRupiah(labakotor.ToString());
        txtlabakotor.Text = txtlabakotor.Text.Replace("Rp", "");
         
        txttotalbiaya.Text = gb.ToRupiah(totalbiaya.ToString());
        txttotalbiaya.Text = txttotalbiaya.Text.Replace("Rp", "");
         
        txtlababersihsebelumpajak.Text = gb.ToRupiah(lababersih.ToString());
        txtlababersihsebelumpajak.Text = txtlababersihsebelumpajak.Text.Replace("Rp", "");
        txtpajakpenghasilan.Focus();
    }

