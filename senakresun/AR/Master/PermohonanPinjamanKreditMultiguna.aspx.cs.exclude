            var2[38] = gb.CreateSPParameter("@ktp_penjamin", ParameterDirection.Input, SqlDbType.VarChar, 200, txtktppenjamin.Text, typeof(string));
            var2[39] = gb.CreateSPParameter("@nama_penjamin", ParameterDirection.Input, SqlDbType.VarChar, 100, TextBox13.Text, typeof(string));
            var2[40] = gb.CreateSPParameter("@golongan_penjamin", ParameterDirection.Input, SqlDbType.VarChar, 250, ddlgolonganpenjamin.SelectedValue, typeof(string));
            var2[41] = gb.CreateSPParameter("@pendapatan_bulan", ParameterDirection.Input, SqlDbType.Decimal, 100, txtpendapatanperbulan.Text, typeof(string));
            var2[42] = gb.CreateSPParameter("@fisik_jaminan", ParameterDirection.Input, SqlDbType.VarChar, 100, ddlfisikjaminan.SelectedValue, typeof(string));
            var2[43] = gb.CreateSPParameter("@jaminan_tambahan", ParameterDirection.Input, SqlDbType.VarChar, 250, TextBox1.Text, typeof(string));
            var2[44] = gb.CreateSPParameter("@biaya_cadangan", ParameterDirection.Input, SqlDbType.Decimal, 10, TextBox3.Text, typeof(string));
            var2[45] = gb.CreateSPParameter("@nilai_taksasi", ParameterDirection.Input, SqlDbType.Decimal, 250, TextBox5.Text, typeof(string));
            var2[46] = gb.CreateSPParameter("@angsuran_dimuka", ParameterDirection.Input, SqlDbType.Decimal, 10, txtangsurandimuka.Text, typeof(string));
            var2[47] = gb.CreateSPParameter("@blokir_angsuran", ParameterDirection.Input, SqlDbType.Decimal, 250, TextBox14.Text, typeof(string));
            var2[48] = gb.CreateSPParameter("@nominal_blokir_angsuran", ParameterDirection.Input, SqlDbType.Decimal, 20, TextBox15.Text, typeof(string));
            var2[49] = gb.CreateSPParameter("@jenis_blokir", ParameterDirection.Input, SqlDbType.VarChar, 5, ddljenisblokir.SelectedValue, typeof(string));
            var2[50] = gb.CreateSPParameter("@status_dalam_keluarga", ParameterDirection.Input, SqlDbType.VarChar, 10, ddlstatuskawin.SelectedValue, typeof(string));
            var2[51] = gb.CreateSPParameter("@Siklus", ParameterDirection.Input, SqlDbType.VarChar, 10, siklus, typeof(string));

            ge.ListDataset = gb.GetDataJustOutPut("AR_APPROVAL_HISTORY", var2, "constrmf");

            if (ge.ListDataset.Tables[0].Rows[0][0].ToString().Contains("Success"))
            {

                ScriptManager.RegisterStartupScript(this, this.GetType(), "Javascript", "javascript:Alert('Save Done!','You successfully save this Project','top-right','success','1');", true);


            }
            else
            {

                ScriptManager.RegisterStartupScript(this, this.GetType(), "Javascript", "javascript:SweetAlert('" + ge.ListDataset.Tables[0].Rows[0][0].ToString() + "');", true);
                gb.SaveErroLog(ge.ListDataset.Tables[0].Rows[0][0].ToString(), Path.GetFileName(Request.Path), SessLoginID, Server.MapPath("~/ErrorLog/" + "ErrorLog" + DateTime.Now.ToString("MM") + DateTime.Now.ToString("yyyy") + ".xml"));

            }

        }

        catch (Exception X)
        {
            ScriptManager.RegisterStartupScript(this, this.GetType(), "Javascript", "javascript:SweetAlert('" + X.Message.ToString().Replace("'", "") + "');", true);
            gb.SaveErroLog(X.Message.ToString(), Path.GetFileName(Request.Path), SessLoginID, Server.MapPath("~/ErrorLog/" + "ErrorLog" + DateTime.Now.ToString("MM") + DateTime.Now.ToString("yyyy") + ".xml"));

        }

        Page_Load(this.Page, e);
    }

